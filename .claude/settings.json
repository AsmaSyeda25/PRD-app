{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-reminder.py\" 2>/dev/null || true",
            "statusMessage": "Checking context usage..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/precompact-preserve.sh\" 2>/dev/null || true",
            "statusMessage": "Preserving context checkpoint..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/restore-checkpoint.sh\" 2>/dev/null || true",
            "statusMessage": "Restoring context checkpoint..."
          }
        ]
      }
    ]
  }
}
