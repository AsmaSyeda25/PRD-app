    {"key": "overview",            "chapter": 3, "need": "mandatory", "match": ["Overview", "Media Types Supported"]},
    {"key": "media_channels",      "chapter": 3, "need": "mandatory", "match": ["Media Channels"]},
    {"key": "data_types",          "chapter": 3, "need": "mandatory", "match": ["Data Types"]},
    {"key": "intervals",           "chapter": 3, "need": "mandatory", "match": ["Intervals Supported"]},
    {"key": "hist_rt_supported",   "chapter": 3, "need": "mandatory", "match": ["Historical and Real-Time Supported", "Historical and Real Time Supported"]},
    {"key": "vendor_versions",     "chapter": 3, "need": "mandatory", "match": ["Vendor Versions Supported"]},
    {"key": "technical_solution",  "chapter": 4, "need": "mandatory", "match": ["Technical Solution"]},
    {"key": "tech_cloud",          "chapter": 4, "need": "mandatory", "match": ["Technical Solution for WFM Cloud", "WFM Cloud Solution"]},
    {"key": "cloud_rt_intro",      "chapter": 4, "need": "expected",  "match": ["Introduction for Real-Time", "Introduction for Real Time"]},
    {"key": "cloud_rt_flow",       "chapter": 4, "need": "expected",  "match": ["Technical Solution Flow for Real-Time", "Flow for Real-Time", "Flow for Historical and Real-Time"], "expects": "diagram"},
    {"key": "cloud_hist_intro",    "chapter": 4, "need": "expected",  "match": ["Introduction for Historical"]},
    {"key": "cloud_hist_flow",     "chapter": 4, "need": "expected",  "match": ["Technical Solution Flow for Historical", "Flow for Historical"], "expects": "diagram"},
    {"key": "protocol_summary",    "chapter": 4, "need": "mandatory", "match": ["Protocol Summary"]},
    {"key": "data_retrieval",      "chapter": 4, "need": "mandatory", "match": ["Data Retrieval Specifics", "Data Retrieval"]},
    {"key": "api_call_type",       "chapter": 4, "need": "conditional","match": ["API Call Type Support"]},
    {"key": "historical",          "chapter": 5, "need": "mandatory", "match": ["Historical Integration"]},
    {"key": "media_class",         "chapter": 5, "need": "mandatory", "match": ["Media Types and Classifications"]},
    {"key": "contact_pegging",     "chapter": 5, "need": "mandatory", "match": ["Contact Data Pegging"]},
    {"key": "data_requirements",   "chapter": 5, "need": "mandatory", "match": ["Data Requirements"]},
    {"key": "queue_data",          "chapter": 5, "need": "mandatory", "match": ["Queue Data"], "expects": "table"},
    {"key": "agent_queue_data",    "chapter": 5, "need": "mandatory", "match": ["Agent Queue Data"]},
    {"key": "agent_system_data",   "chapter": 5, "need": "mandatory", "match": ["Agent System Data"]},
    {"key": "reposting",           "chapter": 5, "need": "mandatory", "match": ["Re-posting Capability", "Reposting Capability", "Re-posting"]},
    {"key": "realtime",            "chapter": 6, "need": "mandatory", "match": ["Real-Time Integration", "Real Time Integration"]},
    {"key": "data_mapping",        "chapter": 6, "need": "mandatory", "match": ["Data Mapping"], "expects": "table"},
    {"key": "data_constraints",    "chapter": 6, "need": "mandatory", "match": ["Data Constraints"]},
    {"key": "other_rt",            "chapter": 6, "need": "conditional","match": ["Other Real-Time Information", "Other Real Time Information"]},
    {"key": "activity_convention", "chapter": 6, "need": "conditional","match": ["Agent Activity Generation Convention"]},
    {"key": "activity_summary",    "chapter": 6, "need": "conditional","match": ["Agent Activity Summary"]},
    {"key": "activity_details",    "chapter": 6, "need": "conditional","match": ["List of Agent Activity Details"]},
    {"key": "scenario",            "chapter": 6, "need": "conditional","match": ["Scenario Considerations"]},
    {"key": "observations",        "chapter": 6, "need": "conditional","match": ["Observations"]},
    {"key": "restrictions",        "chapter": 7, "need": "mandatory", "match": ["Restrictions and Limitations"]}
  ]
